#!/usr/bin/env bash

# Neovim Session Manager - mimics GNU screen interface
# Usage similar to screen: nvim-screen [-S name] [-ls] [-r [name]] [-d name] [-k name]
#
# Portability: targets bash 3.2 (macOS default shell). No mapfile/readarray,
# no associative arrays, and empty arrays are expanded with the
# ${arr[@]+"${arr[@]}"} idiom because bash < 4.4 treats "${arr[@]}" on an
# empty array as an unbound variable under 'set -u'.

set -euo pipefail

# Configuration
VERSION="0.4.3"
USER="${USER:-$(whoami)}"
SESSION_DIR="${XDG_RUNTIME_DIR:-/tmp}/nvim-sessions-${USER}"
SOCKET_PREFIX="nvim-session"
SSH_CONTROL_PREFIX="ssh-control"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/nvim-screen"

# Link supervision, all overridable from the environment. The control master
# pings the server every KEEPALIVE_INTERVAL seconds and gives up after
# KEEPALIVE_COUNT unanswered pings, so a dead network is noticed in roughly
# interval*count seconds instead of whenever TCP eventually times out.
KEEPALIVE_INTERVAL="${NVIM_SCREEN_KEEPALIVE_INTERVAL:-10}"
KEEPALIVE_COUNT="${NVIM_SCREEN_KEEPALIVE_COUNT:-3}"
CONTROL_CHECK_TIMEOUT="${NVIM_SCREEN_CONTROL_CHECK_TIMEOUT:-2}"
QUERY_TIMEOUT="${NVIM_SCREEN_QUERY_TIMEOUT:-10}"
# Watchdog that supervises an attached session (0 disables it)
WATCHDOG_ENABLED="${NVIM_SCREEN_WATCHDOG:-1}"
WATCHDOG_TICK="${NVIM_SCREEN_WATCHDOG_TICK:-3}"
# Ticks between end-to-end probes of the host (0 disables those)
DEEP_PROBE_EVERY="${NVIM_SCREEN_DEEP_PROBE_EVERY:-10}"
DEEP_PROBE_TIMEOUT="${NVIM_SCREEN_DEEP_PROBE_TIMEOUT:-15}"
DEEP_PROBE_FAILURES="${NVIM_SCREEN_DEEP_PROBE_FAILURES:-2}"

# Remote invocations must not rely on the login shell's PATH: non-interactive
# SSH commands often miss ~/.local/bin, where nvim-screen installs itself.
REMOTE_PATH='PATH="$HOME/.local/bin:$PATH"'

# Lua one-liner that detaches every attached UI client and returns the count.
DETACH_UIS_LUA='luaeval("(function() local n=0 for _,ui in ipairs(vim.api.nvim_list_uis()) do if ui.chan and ui.chan>0 then pcall(vim.fn.chanclose,ui.chan) n=n+1 end end return n end)()")'

# Colors for output
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

# Ensure session directory exists
mkdir -p "$SESSION_DIR"

# --------------------------------------------------------------------------
# Terminal state
#
# A full-screen client - Neovim's TUI, usually at the far end of an SSH
# connection - leaves the terminal in raw mode, on the alternate screen, with
# mouse reporting, bracketed paste and alternate character sets enabled. When
# it dies without unwinding that (dropped link, killed SSH, crash) the shell
# you land back in is unusable: no echo, no newlines, line-drawing characters
# instead of text. Everything below puts the terminal back, on every exit
# path, and only when we actually handed the terminal to such a client.
# --------------------------------------------------------------------------
TERM_GUARD_ARMED=0
SAVED_STTY=""
WATCHDOG_PID=""
SSH_ATTACH_PID=""
LINK_LOST_FLAG=""

# /dev/tty exists as a device node even with no controlling terminal to open,
# so test by opening it. stderr is redirected before the open is attempted:
# the shell reports a failed redirection on whatever stderr is at that point.
have_tty() {
    { : >/dev/tty; } 2>/dev/null
}

# stty against the controlling terminal rather than stdin, which may have
# been redirected by the caller
tty_stty() {
    if have_tty; then
        stty "$@" 2>/dev/null </dev/tty
    else
        stty "$@" 2>/dev/null
    fi
}

# Remember the terminal state before handing the tty to a full-screen client
arm_terminal_guard() {
    SAVED_STTY=$(tty_stty -g || true)
    TERM_GUARD_ARMED=1
}

disarm_terminal_guard() {
    TERM_GUARD_ARMED=0
    SAVED_STTY=""
}

# The modes a full-screen application may have left set. Deliberately not
# 'tput reset' or RIS: those also erase the screen and the scrollback, which
# throws away whatever the user still wanted to read.
emit_terminal_reset() {
    printf '\033[?1000l\033[?1002l\033[?1003l\033[?1005l\033[?1006l\033[?1015l'
    printf '\033[?2004l'                       # bracketed paste off
    printf '\033[?1004l'                       # focus reporting off
    printf '\033[?1l\033>'                     # normal cursor keys, numeric keypad
    printf '\033[?7h'                          # auto-wrap back on
    printf '\033[4l'                           # replace mode, not insert
    printf '\033[r'                            # scrolling region back to full screen
    printf '\033(B\033)B\017'                  # ASCII in G0/G1: undoes line-drawing garbage
    printf '\033[m'                            # default colours and attributes
    printf '\033[?1049l\033[?1047l\033[?47l'   # leave the alternate screen
    printf '\033[?25h'                         # cursor visible again
}

restore_terminal() {
    if [[ -n "$SAVED_STTY" ]]; then
        tty_stty "$SAVED_STTY" || tty_stty sane || true
    else
        tty_stty sane || true
    fi

    if have_tty; then
        emit_terminal_reset 2>/dev/null >/dev/tty || true
    elif [[ -t 1 ]]; then
        emit_terminal_reset || true
    fi
}

# Repair the terminal after the fact: 'nvim-screen -reset' in the shell you
# were dropped into when a session or connection died badly.
reset_local_terminal() {
    SAVED_STTY=""
    restore_terminal
    echo "Terminal reset."
}

on_exit() {
    local status=$?
    stop_link_watchdog
    if [[ -n "$SSH_ATTACH_PID" ]]; then
        kill -TERM "$SSH_ATTACH_PID" 2>/dev/null || true
    fi
    if [[ -n "$LINK_LOST_FLAG" ]]; then
        rm -f "$LINK_LOST_FLAG"
    fi
    if [[ "$TERM_GUARD_ARMED" == "1" ]]; then
        restore_terminal
        disarm_terminal_guard
    fi
    return $status
}

on_signal() {
    on_exit || true
    exit 130
}

trap on_exit EXIT
trap on_signal INT TERM HUP

# --------------------------------------------------------------------------
# Helpers
# --------------------------------------------------------------------------

# macOS ships no timeout(1); coreutils installs it as gtimeout
TIMEOUT_CMD=""
if command -v timeout &>/dev/null; then
    TIMEOUT_CMD="timeout"
elif command -v gtimeout &>/dev/null; then
    TIMEOUT_CMD="gtimeout"
fi

# Run a command with a time limit, returning 124 on expiry like GNU timeout.
# The fallback path matters: without it every timed check silently fails on a
# stock macOS, and a stale control socket then looks dead on every call.
run_with_timeout() {
    local secs="$1"
    shift

    if [[ -n "$TIMEOUT_CMD" ]]; then
        "$TIMEOUT_CMD" "$secs" "$@"
        return $?
    fi

    "$@" &
    local cmd_pid=$!
    local waited=0
    local limit=$((secs * 5))
    local status=0

    while kill -0 "$cmd_pid" 2>/dev/null; do
        if [[ $waited -ge $limit ]]; then
            kill -TERM "$cmd_pid" 2>/dev/null || true
            sleep 0.5
            kill -KILL "$cmd_pid" 2>/dev/null || true
            wait "$cmd_pid" 2>/dev/null || true
            return 124
        fi
        sleep 0.2
        waited=$((waited + 1))
    done

    wait "$cmd_pid" 2>/dev/null || status=$?
    return $status
}

# Function to get the init script to use
get_init_script() {
    local init_script="$CONFIG_DIR/init.lua"
    if [[ -f "$init_script" ]]; then
        echo "$init_script"
    else
        echo ""
    fi
}

# Function to sanitize a hostname for use in filenames
sanitize_host() {
    echo "${1//[^a-zA-Z0-9._-]/_}"
}

# Function to get SSH control master socket path
get_ssh_control_path() {
    local ssh_host="$1"
    echo "$SESSION_DIR/${SSH_CONTROL_PREFIX}-$(sanitize_host "$ssh_host").sock"
}

# Function to get hostname from SSH control socket path
get_host_from_control_path() {
    local control_path="$1"
    local filename="${control_path##*/}"
    local safe_host="${filename#${SSH_CONTROL_PREFIX}-}"
    safe_host="${safe_host%.sock}"
    # Reverse the sanitization (best effort, may not be perfect)
    echo "$safe_host"
}

# Function to get all active SSH hosts, one per line
get_active_ssh_hosts() {
    local control_socket host
    for control_socket in "$SESSION_DIR"/${SSH_CONTROL_PREFIX}-*.sock; do
        if [[ -S "$control_socket" ]]; then
            host=$(get_host_from_control_path "$control_socket")
            if check_ssh_control_master "$control_socket" 2>/dev/null; then
                echo "$host"
            fi
        fi
    done
}

# Function to find which remote host has a session
find_remote_session() {
    local session_name="$1"
    local hosts=() host
    while IFS= read -r host; do
        hosts+=("$host")
    done < <(get_active_ssh_hosts)

    for host in ${hosts[@]+"${hosts[@]}"}; do
        # Check if session exists on this host
        if ssh_query "$host" "[ -S \"\${XDG_RUNTIME_DIR:-/tmp}/nvim-sessions-\$USER/nvim-session-$session_name.sock\" ]" 2>/dev/null; then
            echo "$host"
            return 0
        fi
    done

    return 1
}

# Function to check if SSH control master is active
check_ssh_control_master() {
    local control_path="$1"
    local out=""
    # Hostname is not actually needed - the socket contains the connection info
    # Using a dummy value since SSH ignores it when using control master.
    # This is a purely local question (is the master process alive?), so it is
    # cheap and answers even when the network is gone - unless the master
    # itself is wedged, hence the time limit.
    out=$(run_with_timeout "$CONTROL_CHECK_TIMEOUT" \
        ssh -O check -S "$control_path" dummy 2>&1) || true

    case "$out" in
        *"Master running"*) return 0 ;;
        *) return 1 ;;
    esac
}

# Function to establish SSH control master
establish_ssh_control_master() {
    local ssh_host="$1"
    local control_path
    control_path=$(get_ssh_control_path "$ssh_host")

    # Check if control master already exists and is working
    if [[ -S "$control_path" ]] && check_ssh_control_master "$control_path"; then
        return 0
    fi

    # A dead control socket would make ssh refuse to create a new master.
    # Terminate rather than unlink: an unresponsive master left running keeps
    # holding the connection (and any sessions on it) hostage.
    if [[ -S "$control_path" ]]; then
        terminate_ssh_master "$control_path"
    fi
    rm -f "$control_path"

    # Establish new control master in background. The keepalives are what
    # makes a dropped link fail fast: without them the master (and every
    # session multiplexed over it, including your editor) sits in a TCP
    # retransmit loop for minutes with the terminal frozen.
    if ! ssh -fNM -S "$control_path" \
        -o ControlPersist=yes \
        -o ServerAliveInterval="$KEEPALIVE_INTERVAL" \
        -o ServerAliveCountMax="$KEEPALIVE_COUNT" \
        -o TCPKeepAlive=yes \
        "$ssh_host" 2>&1; then
        echo -e "${RED}Failed to establish SSH connection to $ssh_host${NC}"
        return 1
    fi

    # Verify the control master is working
    sleep 0.5
    if check_ssh_control_master "$control_path"; then
        return 0
    else
        echo -e "${RED}SSH control master established but not responding${NC}"
        return 1
    fi
}

# Function to terminate the master process behind a control socket.
# 'ssh -O exit' alone is not enough: some OpenSSH versions acknowledge the
# request but leave the master (and any listeners it holds) running.
terminate_ssh_master() {
    local control_path="$1"
    local master_pid check_out=""

    # Time-limited: the master we are trying to get rid of may be the wedged
    # one, in which case an unbounded 'ssh -O' would hang here too
    check_out=$(run_with_timeout "$CONTROL_CHECK_TIMEOUT" \
        ssh -O check -S "$control_path" dummy 2>&1) || true
    master_pid=$(echo "$check_out" | grep -o 'pid=[0-9]*' | cut -d= -f2 || true)

    run_with_timeout "$CONTROL_CHECK_TIMEOUT" \
        ssh -O exit -S "$control_path" dummy &>/dev/null || true

    if [[ "$master_pid" =~ ^[0-9]+$ ]]; then
        sleep 0.2
        if kill -0 "$master_pid" 2>/dev/null; then
            kill "$master_pid" 2>/dev/null || true
            sleep 0.2
            kill -0 "$master_pid" 2>/dev/null && kill -9 "$master_pid" 2>/dev/null
        fi
    fi
    rm -f "$control_path"
}

# Function to execute command via SSH using control master
ssh_exec() {
    local ssh_host="$1"
    shift
    local control_path
    control_path=$(get_ssh_control_path "$ssh_host")

    # Hostname not needed - socket contains connection info
    # But we still accept it as parameter for backwards compatibility
    ssh -S "$control_path" dummy "$@"
}

# --------------------------------------------------------------------------
# Link watchdog
#
# When the network dies under an attached session, SSH can take a long time
# to notice - and while it hasn't noticed, the terminal is frozen in Neovim's
# alternate screen with no way out: the escape sequence (Enter ~ .) only gets
# through if the client is still reading your keystrokes, which a wedged
# client is not. The watchdog is the way out. It runs beside the attached
# session, notices the dead link on its own, and kills the SSH client so the
# script regains control and puts the terminal back.
# --------------------------------------------------------------------------

declare_link_lost() {
    local flag="$1" ssh_pid="$2"

    : > "$flag"
    # SIGTERM first: a responsive ssh will restore the terminal itself
    kill -TERM "$ssh_pid" 2>/dev/null || true
    sleep 1
    kill -KILL "$ssh_pid" 2>/dev/null || true
}

start_link_watchdog() {
    local ssh_host="$1" ssh_pid="$2"

    [[ "$WATCHDOG_ENABLED" == "0" ]] && return 0

    local control_path flag
    control_path=$(get_ssh_control_path "$ssh_host")
    flag="$LINK_LOST_FLAG"

    (
        ticks=0
        deep_fails=0

        while kill -0 "$ssh_pid" 2>/dev/null; do
            sleep "$WATCHDOG_TICK"
            kill -0 "$ssh_pid" 2>/dev/null || exit 0

            # Local and instant: with ServerAlive* set, the master exits a
            # few seconds after the link dies. A session outliving its master
            # is a session that will never recover.
            if ! check_ssh_control_master "$control_path"; then
                declare_link_lost "$flag" "$ssh_pid"
                exit 0
            fi

            # Backstop for a master that is alive but wedged: an actual round
            # trip to the host. Rare, so it runs on a slow cadence.
            ticks=$((ticks + 1))
            if [[ "$DEEP_PROBE_EVERY" -gt 0 ]] && [[ $((ticks % DEEP_PROBE_EVERY)) -eq 0 ]]; then
                if run_with_timeout "$DEEP_PROBE_TIMEOUT" \
                    ssh -S "$control_path" dummy true; then
                    deep_fails=0
                else
                    deep_fails=$((deep_fails + 1))
                    if [[ $deep_fails -ge $DEEP_PROBE_FAILURES ]]; then
                        declare_link_lost "$flag" "$ssh_pid"
                        exit 0
                    fi
                fi
            fi
        done
    ) </dev/null >/dev/null 2>&1 &

    WATCHDOG_PID=$!
}

stop_link_watchdog() {
    [[ -n "$WATCHDOG_PID" ]] || return 0
    kill -TERM "$WATCHDOG_PID" 2>/dev/null || true
    wait "$WATCHDOG_PID" 2>/dev/null || true
    WATCHDOG_PID=""
}

# Function to run an interactive command on a remote host over the control
# master, supervising the link and the terminal for as long as it runs
ssh_interactive() {
    local ssh_host="$1" remote_cmd="$2"
    local control_path status=0
    control_path=$(get_ssh_control_path "$ssh_host")

    LINK_LOST_FLAG="$SESSION_DIR/.link-lost.$$"
    rm -f "$LINK_LOST_FLAG"

    arm_terminal_guard

    # -e '~' asks for the usual escape character explicitly, so 'Enter ~ .'
    # drops you back to the local shell. NVIM_SCREEN_SSH_DIRECT=1 gives the
    # session its own connection instead of a multiplexed one: it costs
    # another authentication, but escape handling and keepalives are then
    # done by this client itself, which older OpenSSH builds do not do for
    # multiplexed sessions.
    local ssh_opts=(-t -e '~')
    if [[ "${NVIM_SCREEN_SSH_DIRECT:-0}" == "1" ]]; then
        ssh_opts+=(-o ControlPath=none -o ControlMaster=no
                   -o ServerAliveInterval="$KEEPALIVE_INTERVAL"
                   -o ServerAliveCountMax="$KEEPALIVE_COUNT"
                   -o TCPKeepAlive=yes "$ssh_host")
    else
        ssh_opts+=(-S "$control_path" dummy)
    fi

    # ssh has to run as a background job so the watchdog gets its PID and the
    # wait below stays interruptible. A non-interactive shell points a
    # background job's stdin at /dev/null, so hand it the terminal explicitly.
    if [[ -t 0 ]]; then
        exec 3<&0
        ssh "${ssh_opts[@]}" "$remote_cmd" <&3 &
        SSH_ATTACH_PID=$!
        exec 3<&-
    else
        ssh "${ssh_opts[@]}" "$remote_cmd" &
        SSH_ATTACH_PID=$!
    fi

    start_link_watchdog "$ssh_host" "$SSH_ATTACH_PID"
    wait "$SSH_ATTACH_PID" || status=$?
    SSH_ATTACH_PID=""
    stop_link_watchdog

    restore_terminal
    disarm_terminal_guard

    if [[ -f "$LINK_LOST_FLAG" ]]; then
        rm -f "$LINK_LOST_FLAG"
        LINK_LOST_FLAG=""
        echo -e "${YELLOW}Connection to $ssh_host lost - returned to the local shell.${NC}" >&2
        echo "The session is still running there; reattach once the host is reachable:" >&2
        echo "  $(basename "$0") -r $ssh_host:<session>" >&2
        return 255
    fi

    LINK_LOST_FLAG=""
    return $status
}

# Function to run a short read-only query on a remote host. Time-limited, so
# a host that has gone away can't hang -ls, completion, or the checks an
# attach makes before it hands the terminal over.
ssh_query() {
    local ssh_host="$1"
    shift
    run_with_timeout "$QUERY_TIMEOUT" \
        ssh -S "$(get_ssh_control_path "$ssh_host")" dummy "$@"
}

# Function to run nvim-screen on a remote host
remote_screen() {
    local ssh_host="$1"
    shift
    ssh_query "$ssh_host" "$REMOTE_PATH nvim-screen $*"
}

# Function to install nvim-screen (this script + config) on a remote host
bootstrap_remote() {
    local ssh_host="$1"
    local self="${BASH_SOURCE[0]}"

    if ! ssh_exec "$ssh_host" "$REMOTE_PATH command -v nvim" &>/dev/null; then
        echo -e "${RED}Error: nvim not found on $ssh_host.${NC}"
        echo "Run '$(basename "$0") -s $ssh_host -sync' to install Neovim there."
        return 1
    fi

    echo "Installing nvim-screen on $ssh_host..."
    ssh_exec "$ssh_host" 'mkdir -p "$HOME/.local/bin" "${XDG_CONFIG_HOME:-$HOME/.config}/nvim-screen"'
    ssh_exec "$ssh_host" 'cat > "$HOME/.local/bin/nvim-screen" && chmod +x "$HOME/.local/bin/nvim-screen"' < "$self"

    local init_script
    init_script=$(get_init_script)
    if [[ -n "$init_script" ]]; then
        ssh_exec "$ssh_host" 'cat > "${XDG_CONFIG_HOME:-$HOME/.config}/nvim-screen/init.lua"' < "$init_script"
    fi

    echo -e "${GREEN}nvim-screen installed on $ssh_host${NC}"
}

# Function to install Neovim itself on a remote host (official stable
# build into ~/.local, no root required)
install_remote_nvim() {
    local ssh_host="$1"
    local os arch asset
    os=$(ssh_exec "$ssh_host" 'uname -s' 2>/dev/null)
    arch=$(ssh_exec "$ssh_host" 'uname -m' 2>/dev/null)

    case "$os-$arch" in
        Linux-x86_64)           asset="nvim-linux-x86_64" ;;
        Linux-aarch64|Linux-arm64) asset="nvim-linux-arm64" ;;
        Darwin-x86_64)          asset="nvim-macos-x86_64" ;;
        Darwin-arm64)           asset="nvim-macos-arm64" ;;
        *)
            echo -e "${RED}Error: No prebuilt Neovim for $os/$arch. Install nvim on $ssh_host manually.${NC}"
            return 1
            ;;
    esac

    # NVIM_SCREEN_NVIM_URL overrides the download source (mirrors, air-gapped)
    local url="${NVIM_SCREEN_NVIM_URL:-https://github.com/neovim/neovim/releases/download/stable/${asset}.tar.gz}"

    echo "Installing Neovim (stable, $asset) on $ssh_host..."
    if ! ssh_exec "$ssh_host" "
        set -e
        url='$url'
        # BSD mktemp rejects templates with a suffix after the X's; tar
        # doesn't need the .tar.gz extension anyway
        tmp=\$(mktemp \"\${TMPDIR:-/tmp}/nvim-stable.XXXXXX\")
        if command -v curl >/dev/null 2>&1; then
            curl -fsSL \"\$url\" -o \"\$tmp\"
        elif command -v wget >/dev/null 2>&1; then
            wget -qO \"\$tmp\" \"\$url\"
        else
            echo 'Error: neither curl nor wget available on remote' >&2
            exit 1
        fi
        mkdir -p \"\$HOME/.local/opt\" \"\$HOME/.local/bin\"
        rm -rf \"\$HOME/.local/opt/${asset}\"
        tar -xzf \"\$tmp\" -C \"\$HOME/.local/opt\"
        rm -f \"\$tmp\"
        ln -sf \"\$HOME/.local/opt/${asset}/bin/nvim\" \"\$HOME/.local/bin/nvim\"
    "; then
        echo -e "${RED}Failed to install Neovim on $ssh_host${NC}"
        return 1
    fi

    local nvim_version
    nvim_version=$(ssh_exec "$ssh_host" "$REMOTE_PATH nvim --version" 2>/dev/null | head -1 || true)
    if [[ -z "$nvim_version" ]]; then
        echo -e "${RED}Neovim installed but not runnable on $ssh_host${NC}"
        return 1
    fi
    echo -e "${GREEN}Installed $nvim_version on $ssh_host${NC}"
}

# Function to sync nvim-screen and the local Neovim config to a remote host,
# installing Neovim itself if the remote doesn't have it
sync_remote() {
    local ssh_host="$1"

    if ! ssh_exec "$ssh_host" "$REMOTE_PATH command -v nvim" &>/dev/null; then
        install_remote_nvim "$ssh_host" || return 1
    fi

    bootstrap_remote "$ssh_host" || return 1

    local config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
    if [[ -d "$config_home/nvim" ]]; then
        echo "Syncing Neovim config to $ssh_host..."
        tar -C "$config_home" -czf - nvim | ssh_exec "$ssh_host" \
            'mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}" && tar -C "${XDG_CONFIG_HOME:-$HOME/.config}" -xzf -'
        echo -e "${GREEN}Neovim config synced. Plugins are installed by your plugin manager on first run.${NC}"
    else
        echo "No local Neovim config at $config_home/nvim, skipping config sync."
    fi
}

# Function to generate a session name
generate_session_name() {
    local base_name="${PWD##*/}"
    local counter=0
    local session_name="$base_name"

    while [[ -S "$SESSION_DIR/${SOCKET_PREFIX}-${session_name}.sock" ]]; do
        counter=$((counter + 1))
        session_name="${base_name}-${counter}"
    done

    echo "$session_name"
}

# Function to get socket path for a session
get_socket_path() {
    local session_name="$1"
    echo "$SESSION_DIR/${SOCKET_PREFIX}-${session_name}.sock"
}

# Function to check if a socket is healthy
check_socket_health() {
    local socket_path="$1"
    nvim --headless --server "$socket_path" --remote-expr '1+1' &>/dev/null
    return $?
}

# Function to list active sessions
list_sessions() {
    local ssh_host="$1"
    local has_sessions=false

    if [[ -n "$ssh_host" ]]; then
        # List remote sessions (when -s flag is used)
        echo "Active Neovim sessions on $ssh_host:"
        echo
        remote_screen "$ssh_host" "-ls" 2>&1
        return
    fi

    # List all sessions (local and remote)
    echo "Active Neovim sessions:"
    echo

    # List local sessions
    for socket in "$SESSION_DIR"/${SOCKET_PREFIX}-*.sock; do
        if [[ -S "$socket" ]]; then
            has_sessions=true
            local session_name="${socket##*/}"
            session_name="${session_name#${SOCKET_PREFIX}-}"
            session_name="${session_name%.sock}"

            # Check if session is healthy
            if check_socket_health "$socket"; then
                echo -e "  ${GREEN}●${NC} $session_name"
            else
                echo -e "  ${YELLOW}○${NC} $session_name (unresponsive)"
            fi
        fi
    done

    # List sessions on all active remote hosts
    local hosts=() host
    while IFS= read -r host; do
        hosts+=("$host")
    done < <(get_active_ssh_hosts)

    for host in ${hosts[@]+"${hosts[@]}"}; do
        if [[ -n "$host" ]]; then
            # Get remote sessions
            local remote_sessions query_status=0
            remote_sessions=$(ssh_query "$host" "
                for socket in \"\${XDG_RUNTIME_DIR:-/tmp}/nvim-sessions-\$USER\"/nvim-session-*.sock; do
                    if [[ -S \"\$socket\" ]]; then
                        name=\"\${socket##*/}\"
                        name=\"\${name#nvim-session-}\"
                        name=\"\${name%.sock}\"
                        echo \"\$name\"
                    fi
                done
            " 2>/dev/null) || query_status=$?

            if [[ $query_status -eq 124 ]]; then
                # Control master still up, but the host isn't answering
                has_sessions=true
                echo -e "  ${YELLOW}○${NC} ${host} (not responding)"
            elif [[ -n "$remote_sessions" ]]; then
                has_sessions=true
                while IFS= read -r session; do
                    if [[ -n "$session" ]]; then
                        echo -e "  ${GREEN}●${NC} ${host}:${session}"
                    fi
                done <<< "$remote_sessions"
            fi
        fi
    done

    if [[ "$has_sessions" == false ]]; then
        echo "  No active sessions"
    fi
    echo
}

# Function to attach a UI client to a session and report how it ended
run_client() {
    local session_name="$1"
    local socket_path
    socket_path=$(get_socket_path "$session_name")

    # Evict clients that are still attached. After a dropped connection the
    # previous UI often lingers - its SSH connection is gone but Neovim has
    # not noticed yet - and Neovim sizes the screen to the smallest attached
    # UI, which is exactly the mangled display people meet when they
    # reattach. Set NVIM_SCREEN_SHARE=1 to attach alongside other clients.
    if [[ "${NVIM_SCREEN_SHARE:-0}" != "1" ]]; then
        nvim --headless --server "$socket_path" \
            --remote-expr "$DETACH_UIS_LUA" &>/dev/null || true
    fi

    # Returns when this client detaches or the session ends
    arm_terminal_guard
    nvim --server "$socket_path" --remote-ui || true
    restore_terminal
    disarm_terminal_guard

    if [[ -S "$socket_path" ]] && check_socket_health "$socket_path"; then
        echo "[detached from $session_name]"
    else
        echo "[session $session_name ended]"
    fi
}

# Function to start a new session
start_session() {
    local session_name="$1"
    local ssh_host="$2"
    local workdir="$3"
    shift 3
    # ${1+"$@"}: bash < 4.4 errors on "$@" under 'set -u' when there are
    # no positional parameters
    local nvim_args=(${1+"$@"})
    local socket_path
    socket_path=$(get_socket_path "$session_name")

    if [[ -n "$ssh_host" ]]; then
        # Start remote session via SSH
        local remote_cmd="$REMOTE_PATH nvim-screen -S '$session_name'"
        if [[ -n "$workdir" ]]; then
            printf -v remote_cmd '%s -c %q' "$remote_cmd" "$workdir"
        fi
        # Build nvim args string for remote execution
        if [[ ${#nvim_args[@]} -gt 0 ]]; then
            # Properly quote arguments for remote execution
            local nvim_args_str
            printf -v nvim_args_str ' -- %q' "${nvim_args[@]}"
            remote_cmd+="$nvim_args_str"
        fi

        echo "Starting remote session '$session_name' on $ssh_host..."

        # Start remote session via SSH with pseudo-terminal
        # This will execute nvim-screen on the remote host and attach to it
        local status=0
        ssh_interactive "$ssh_host" "$remote_cmd" || status=$?
        exit $status
    fi

    if [[ -S "$socket_path" ]]; then
        echo -e "${YELLOW}Session '$session_name' already exists.${NC}"
        echo "Use '$0 -r $session_name' to attach to it."
        exit 1
    fi

    # Local session: run the server headless, detached from this terminal,
    # so it survives client exits, terminal crashes, and SSH drops. The
    # terminal then attaches to it as a regular client.
    local init_script
    init_script=$(get_init_script)

    local server_cmd=(nvim --headless --listen "$socket_path")
    if [[ -n "$init_script" ]]; then
        server_cmd+=(-S "$init_script")
    fi
    server_cmd+=(${nvim_args[@]+"${nvim_args[@]}"})

    if command -v setsid &>/dev/null; then
        NVIM_SCREEN_SESSION="$session_name" setsid "${server_cmd[@]}" </dev/null &>/dev/null &
    else
        NVIM_SCREEN_SESSION="$session_name" nohup "${server_cmd[@]}" </dev/null &>/dev/null &
    fi

    # Wait for the server socket to appear
    local i
    for ((i = 0; i < 50; i++)); do
        [[ -S "$socket_path" ]] && break
        sleep 0.1
    done

    if [[ ! -S "$socket_path" ]] || ! check_socket_health "$socket_path"; then
        echo -e "${RED}Failed to start session '$session_name'${NC}"
        exit 1
    fi

    run_client "$session_name"
}

# Function to attach to existing session
attach_session() {
    local session_name="$1"
    local ssh_host=""
    local base_session_name="$session_name"

    # Check if session name contains host prefix (host:session format)
    if [[ "$session_name" =~ ^([^:]+):(.+)$ ]]; then
        ssh_host="${BASH_REMATCH[1]}"
        base_session_name="${BASH_REMATCH[2]}"

        echo "Attaching to remote session '$base_session_name' on $ssh_host..."

        # Establish SSH control master if not already active
        if ! establish_ssh_control_master "$ssh_host"; then
            echo -e "${RED}Failed to establish SSH connection${NC}"
            exit 1
        fi

        # Verify session exists on remote before attempting to attach
        local probe_status=0
        ssh_query "$ssh_host" "[ -S \"\${XDG_RUNTIME_DIR:-/tmp}/nvim-sessions-\$USER/nvim-session-$base_session_name.sock\" ]" 2>/dev/null || probe_status=$?

        if [[ $probe_status -eq 124 ]]; then
            # The link is up as far as the local master knows, but nothing is
            # getting through. Never hand the terminal to a session we cannot
            # reach - that is how it ends up frozen and garbled.
            echo -e "${RED}Error: $ssh_host is not responding.${NC}"
            echo "Run '$(basename "$0") -wipe' once the host is reachable again."
            exit 1
        elif [[ $probe_status -ne 0 ]]; then
            echo -e "${RED}Error: Session '$base_session_name' not found on $ssh_host${NC}"
            exit 1
        fi

        # Attach to remote session via SSH with pseudo-terminal
        local status=0
        ssh_interactive "$ssh_host" \
            "$REMOTE_PATH nvim-screen -r '$base_session_name'" || status=$?
        exit $status
    fi

    # Not in host:session format, check locally first
    local socket_path
    socket_path=$(get_socket_path "$session_name")

    if [[ -S "$socket_path" ]]; then
        # Local session - attach to it
        run_client "$session_name"
        return
    fi

    # Not found anywhere
    echo -e "${RED}Error: Session '$session_name' not found.${NC}"
    echo
    list_sessions ""
    exit 1
}

# Function to detach all clients from a session
detach_session() {
    local session_name="$1"
    local ssh_host=""
    local base_session_name="$session_name"

    # Check if session name contains host prefix (host:session format)
    if [[ "$session_name" =~ ^([^:]+):(.+)$ ]]; then
        ssh_host="${BASH_REMATCH[1]}"
        base_session_name="${BASH_REMATCH[2]}"

        echo "Detaching from remote session '$base_session_name' on $ssh_host..."

        if ! establish_ssh_control_master "$ssh_host"; then
            echo -e "${RED}Failed to establish SSH connection${NC}"
            exit 1
        fi

        remote_screen "$ssh_host" "-d '$base_session_name'"
        return $?
    fi

    # Not in host:session format, check locally
    local socket_path
    socket_path=$(get_socket_path "$session_name")

    if [[ -S "$socket_path" ]]; then
        local detached
        detached=$(nvim --headless --server "$socket_path" \
            --remote-expr "$DETACH_UIS_LUA" 2>/dev/null || true)

        if [[ "$detached" =~ ^[0-9]+$ ]] && [[ "$detached" -gt 0 ]]; then
            echo -e "${GREEN}Detached $detached client(s) from session '$session_name'${NC}"
        else
            echo -e "${YELLOW}No clients attached to session '$session_name'${NC}"
        fi
        return
    fi

    # Check if this is a remote session
    ssh_host=$(find_remote_session "$session_name")

    if [[ -n "$ssh_host" ]]; then
        # For remote session, execute detach on remote host
        echo "Detaching from remote session '$session_name' on $ssh_host..."

        remote_screen "$ssh_host" "-d '$session_name'"
        return $?
    fi

    echo -e "${RED}Error: Session '$session_name' not found.${NC}"
    exit 1
}

# Function to terminate a session
kill_session() {
    local session_name="$1"
    local ssh_host=""
    local base_session_name="$session_name"

    # Check if session name contains host prefix (host:session format)
    if [[ "$session_name" =~ ^([^:]+):(.+)$ ]]; then
        ssh_host="${BASH_REMATCH[1]}"
        base_session_name="${BASH_REMATCH[2]}"

        if ! establish_ssh_control_master "$ssh_host"; then
            echo -e "${RED}Failed to establish SSH connection${NC}"
            exit 1
        fi

        remote_screen "$ssh_host" "-k '$base_session_name'"
        return $?
    fi

    # Not in host:session format, check locally
    local socket_path
    socket_path=$(get_socket_path "$session_name")

    if [[ ! -S "$socket_path" ]]; then
        # Check if this is a remote session
        ssh_host=$(find_remote_session "$session_name" || true)
        if [[ -n "$ssh_host" ]]; then
            remote_screen "$ssh_host" "-k '$session_name'"
            return $?
        fi

        echo -e "${RED}Error: Session '$session_name' not found.${NC}"
        exit 1
    fi

    local pid
    pid=$(nvim --headless --server "$socket_path" --remote-expr 'getpid()' 2>/dev/null || true)

    if [[ "$pid" =~ ^[0-9]+$ ]]; then
        kill "$pid" 2>/dev/null || true
        echo -e "${GREEN}Session '$session_name' terminated.${NC}"
    else
        echo -e "${YELLOW}Session '$session_name' unresponsive, removing stale socket.${NC}"
    fi
    rm -f "$socket_path"
}

# Function to clean up stale sockets
cleanup_stale_sockets() {
    local cleaned=0

    # Clean up stale local session sockets
    for socket in "$SESSION_DIR"/${SOCKET_PREFIX}-*.sock; do
        if [[ -S "$socket" ]]; then
            # Check if socket is healthy
            if ! check_socket_health "$socket"; then
                echo "Removing stale socket: ${socket##*/}"
                rm -f "$socket"
                cleaned=$((cleaned + 1))
            fi
        fi
    done

    # Clean up stale SSH control master sockets
    for control_socket in "$SESSION_DIR"/${SSH_CONTROL_PREFIX}-*.sock; do
        if [[ -S "$control_socket" ]]; then
            # Check if control master is still active
            if ! check_ssh_control_master "$control_socket" 2>/dev/null; then
                echo "Removing stale SSH control socket: ${control_socket##*/}"
                terminate_ssh_master "$control_socket"
                cleaned=$((cleaned + 1))
            fi
        fi
    done

    if [[ $cleaned -eq 0 ]]; then
        echo "No stale sockets found."
    else
        echo "Removed $cleaned stale socket(s)."
    fi
}

# Function to show version
show_version() {
    echo "nvim-screen version $VERSION"
}

# Function to show usage
show_usage() {
    cat << EOF
Neovim Session Manager - GNU screen-like interface for Neovim

Usage: $(basename "$0") [options] [command] [-- nvim_args...]

Options:
  -s <host>          Connect to remote host via SSH (auto-installs nvim-screen there)
  -S <name>          Start a new session with the specified name
  -c <dir>           Working directory for the new session (local or remote)
  -ls, -list         List all active sessions (local and remote)
  -r [name]          Attach to session (if name not specified, attach to last or prompt)
  -d <name>          Detach all clients from the specified session
  -k <name>          Kill (terminate) the specified session
  -sync              Sync nvim-screen and your Neovim config to the remote,
                     installing Neovim there if it's missing (with -s)
  -wipe              Clean up stale/dead sessions
  -reset             Restore a terminal left garbled by a dead session
  -v, --version      Show version information
  -h, --help         Show this help message
  --                 Pass all following arguments to nvim

Examples:
  $(basename "$0") -S myproject                    # Start new session named 'myproject'
  $(basename "$0") -S myproject -- file.txt        # Start session and open file.txt
  $(basename "$0") -s user@host -S remote-proj     # Start session on remote host
  $(basename "$0") -s user@host -c ~/work/proj     # Remote session in ~/work/proj
  $(basename "$0") -s user@host -ls                # List sessions on remote host
  $(basename "$0") -s user@host -sync              # Push nvim + config + nvim-screen to host
  $(basename "$0") -r host:session                 # Attach to remote session
  $(basename "$0") -- -O file1.txt file2.txt       # Start session with vertical split
  $(basename "$0") -S test -- -c 'set number'      # Start session with nvim command

Inside Neovim:
  :q (and :qa, ZZ, ...)    Detach when the quit would end the session
  :Detach                  Detach all clients (session keeps running)
  :Quit                    Actually end the session

When a remote connection drops:
  Enter ~ .                SSH escape - drops you back to the local shell
  (nothing needed)         The link watchdog does the same within ~30s
  -reset                   Repair a terminal that was left garbled

Session sockets are stored in: $SESSION_DIR
EOF
}

# Main script logic
main() {
    local action=""
    local session_name=""
    local ssh_host=""
    local workdir=""
    local do_sync=false
    local nvim_args=()

    # Parse command line arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -s)
                shift
                if [[ $# -gt 0 ]]; then
                    ssh_host="$1"
                    shift
                else
                    echo -e "${RED}Error: -s requires an SSH host${NC}"
                    exit 1
                fi
                ;;
            -S)
                action="start"
                shift
                if [[ $# -gt 0 ]]; then
                    session_name="$1"
                    shift
                else
                    echo -e "${RED}Error: -S requires a session name${NC}"
                    exit 1
                fi
                ;;
            -ls|-list)
                action="list"
                shift
                ;;
            -r|-x)
                action="attach"
                shift
                if [[ $# -gt 0 ]] && [[ ! "$1" =~ ^- ]]; then
                    session_name="$1"
                    shift
                fi
                ;;
            -d|-D)
                action="detach"
                shift
                if [[ $# -gt 0 ]]; then
                    session_name="$1"
                    shift
                else
                    echo -e "${RED}Error: -d requires a session name${NC}"
                    exit 1
                fi
                ;;
            -k|-kill)
                action="kill"
                shift
                if [[ $# -gt 0 ]]; then
                    session_name="$1"
                    shift
                else
                    echo -e "${RED}Error: -k requires a session name${NC}"
                    exit 1
                fi
                ;;
            -c)
                shift
                if [[ $# -gt 0 ]]; then
                    workdir="$1"
                    shift
                else
                    echo -e "${RED}Error: -c requires a directory${NC}"
                    exit 1
                fi
                ;;
            -sync)
                do_sync=true
                shift
                ;;
            -wipe)
                action="wipe"
                shift
                ;;
            -reset)
                action="reset"
                shift
                ;;
            -v|--version)
                show_version
                exit 0
                ;;
            -h|--help)
                show_usage
                exit 0
                ;;
            --)
                # Everything after -- is passed to nvim
                shift
                nvim_args=(${1+"$@"})
                break
                ;;
            *)
                echo -e "${RED}Unknown option: $1${NC}"
                echo
                show_usage
                exit 1
                ;;
        esac
    done

    # -sync only makes sense against a remote host
    if [[ -z "$ssh_host" ]] && [[ "$do_sync" == true ]]; then
        echo -e "${RED}Error: -sync requires -s <host>${NC}"
        exit 1
    fi

    # Default action: start a session, unless the invocation was only about
    # syncing the remote
    if [[ -z "$action" ]]; then
        if [[ "$do_sync" == true ]] && [[ ${#nvim_args[@]} -eq 0 ]]; then
            action="none"
        else
            action="start"
        fi
    fi

    # A local working directory applies right away; a remote one is passed
    # along to the remote nvim-screen invocation in start_session
    if [[ -n "$workdir" ]] && [[ -z "$ssh_host" ]]; then
        if ! cd "$workdir" 2>/dev/null; then
            echo -e "${RED}Error: Cannot change to directory '$workdir'${NC}"
            exit 1
        fi
    fi

    # Handle SSH connection if specified
    if [[ -n "$ssh_host" ]]; then
        echo "Establishing SSH connection to $ssh_host..."
        if ! establish_ssh_control_master "$ssh_host"; then
            exit 1
        fi

        if [[ "$do_sync" == true ]]; then
            sync_remote "$ssh_host" || exit 1
        else
            # Install nvim-screen on the remote if it's missing, and keep
            # it in step with the local version
            local remote_version version_out="" version_status=0
            version_out=$(remote_screen "$ssh_host" "-v" 2>/dev/null) || version_status=$?

            # Bail out before the install path: pushing a script over a link
            # that isn't carrying anything just hangs
            if [[ $version_status -eq 124 ]]; then
                echo -e "${RED}Error: $ssh_host is not responding.${NC}"
                echo "Run '$(basename "$0") -wipe' once the host is reachable again."
                exit 1
            fi

            remote_version=$(echo "$version_out" | awk '{print $NF}')
            if [[ "$remote_version" != "$VERSION" ]]; then
                if [[ -z "$remote_version" ]]; then
                    echo -e "${YELLOW}nvim-screen not found on $ssh_host${NC}"
                else
                    echo -e "${YELLOW}Updating nvim-screen on $ssh_host ($remote_version -> $VERSION)${NC}"
                fi
                bootstrap_remote "$ssh_host" || exit 1
            fi
        fi
    fi

    # Execute action
    case "$action" in
        none)
            ;;
        list)
            list_sessions "$ssh_host"
            ;;
        start)
            if [[ -z "$session_name" ]]; then
                if [[ -n "$ssh_host" ]] && [[ -n "$workdir" ]]; then
                    session_name=$(basename "$workdir")
                else
                    session_name=$(generate_session_name)
                fi
            fi
            start_session "$session_name" "$ssh_host" "$workdir" ${nvim_args[@]+"${nvim_args[@]}"}
            ;;
        attach)
            if [[ -z "$session_name" ]]; then
                # Find available local sessions
                local available_sessions=()

                for socket in "$SESSION_DIR"/${SOCKET_PREFIX}-*.sock; do
                    if [[ -S "$socket" ]]; then
                        local name="${socket##*/}"
                        name="${name#${SOCKET_PREFIX}-}"
                        name="${name%.sock}"
                        available_sessions+=("$name")
                    fi
                done

                if [[ ${#available_sessions[@]} -eq 0 ]]; then
                    echo -e "${RED}No active local sessions found.${NC}"
                    echo "Use 'nvim-screen -ls' to see all sessions including remote ones."
                    exit 1
                elif [[ ${#available_sessions[@]} -eq 1 ]]; then
                    session_name="${available_sessions[0]}"
                else
                    echo "Multiple sessions available:"
                    for i in "${!available_sessions[@]}"; do
                        echo "  $((i+1)). ${available_sessions[$i]}"
                    done
                    echo
                    read -r -p "Select session number (or name): " selection
                    if [[ "$selection" =~ ^[0-9]+$ ]] && [[ $selection -le ${#available_sessions[@]} ]]; then
                        session_name="${available_sessions[$((selection-1))]}"
                    else
                        session_name="$selection"
                    fi
                fi
            fi
            attach_session "$session_name"
            ;;
        detach)
            detach_session "$session_name"
            ;;
        kill)
            kill_session "$session_name"
            ;;
        wipe)
            cleanup_stale_sockets
            echo "Stale sessions cleaned up."
            ;;
        reset)
            reset_local_terminal
            ;;
    esac
}

main ${1+"$@"}
