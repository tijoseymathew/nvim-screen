#!/usr/bin/env bash

# Neovim Session Manager - mimics GNU screen interface
# Usage similar to screen: nvim-screen [-S name] [-ls] [-r [name]] [-d name] [-k name]
#
# Portability: targets bash 3.2 (macOS default shell). No mapfile/readarray,
# no associative arrays, and empty arrays are expanded with the
# ${arr[@]+"${arr[@]}"} idiom because bash < 4.4 treats "${arr[@]}" on an
# empty array as an unbound variable under 'set -u'.

set -euo pipefail

# Set to 1 only once this process has handed the terminal over to an
# interactive UI (a local nvim client, or a remote session over 'ssh -t').
# Those are the only cases that can leave the terminal in a raw state.
TERMINAL_HANDED_OVER=0

# Restore a terminal left in a bad state by a crashed, force-killed, or
# disconnected UI.
#
# Two layers need fixing. 'stty sane' repairs the tty driver (cooked mode,
# echo). But when the SSH connection dies while nvim owns the screen, the
# *terminal emulator* is also stranded in modes nvim never got to switch
# off: the kitty keyboard protocol (every keypress then renders as
# '[27u'-style garbage, which is also why typing 'reset' into the wreckage
# gets nowhere), mouse reporting, bracketed paste, the alternate screen.
# Those live in the emulator, out of stty's reach, so each is switched off
# explicitly below.
#
# Deliberately does NOT use 'tput reset': that emits RIS, which clears the
# screen and scrollback. The sequences below restore a usable terminal
# without touching screen contents, and are no-ops on a healthy one.
cleanup_terminal() {
    [[ "$TERMINAL_HANDED_OVER" == "1" ]] || return 0
    [[ -t 1 ]] || return 0
    stty sane 2>/dev/null || true
    #  [<u      pop kitty keyboard protocol   [>4;0m  modifyOtherKeys off
    #  [?100xl  mouse reporting off           [?1004l focus reporting off
    #  [?2004l  bracketed paste off           [?1l >  normal cursor keys/keypad
    #  [?1049l  leave alternate screen        [0m     reset colors
    #  [?25h    show cursor
    printf '\033[<u\033[>4;0m\033[?1000l\033[?1002l\033[?1003l\033[?1006l\033[?1004l\033[?2004l\033[?1l\033>\033[?1049l\033[0m\033[?25h' 2>/dev/null || true
}

# Clean up on exit and on the signals that would otherwise kill us mid-session
# (an uncaught signal skips the EXIT trap entirely).
trap cleanup_terminal EXIT
trap 'cleanup_terminal; exit 130' INT
trap 'cleanup_terminal; exit 143' TERM
trap 'cleanup_terminal; exit 129' HUP

# Configuration
VERSION="0.4.4"
USER="${USER:-$(whoami)}"
SESSION_DIR="${XDG_RUNTIME_DIR:-/tmp}/nvim-sessions-${USER}"
SOCKET_PREFIX="nvim-session"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/nvim-screen"

# Hosts this user has reached through nvim-screen, one per line. Connection
# multiplexing is the system's business now (see 'Remote hosts' below), so
# there are no control sockets of ours left to enumerate - this file is what
# tells '-ls' and session lookup which hosts are worth asking.
SSH_HOSTS_FILE="$SESSION_DIR/ssh-hosts"

# Time limit for the short, non-interactive remote queries: session lookups,
# '-ls', the remote version check. Without one, a host that has gone away
# hangs the command instead of reporting itself.
QUERY_TIMEOUT="${NVIM_SCREEN_QUERY_TIMEOUT:-10}"
CONNECT_TIMEOUT="${NVIM_SCREEN_CONNECT_TIMEOUT:-5}"

# Remote invocations must not rely on the login shell's PATH: non-interactive
# SSH commands often miss ~/.local/bin, where nvim-screen installs itself.
REMOTE_PATH='PATH="$HOME/.local/bin:$PATH"'

# 'timeout' ships with GNU coreutils; macOS has it only via Homebrew, usually
# as 'gtimeout'. Empty when neither is present, in which case callers run the
# command unguarded.
if command -v timeout >/dev/null 2>&1; then
    TIMEOUT_CMD="timeout"
elif command -v gtimeout >/dev/null 2>&1; then
    TIMEOUT_CMD="gtimeout"
else
    TIMEOUT_CMD=""
fi

# Lua one-liner that detaches every attached UI client and returns the count.
DETACH_UIS_LUA='luaeval("(function() local n=0 for _,ui in ipairs(vim.api.nvim_list_uis()) do if ui.chan and ui.chan>0 then pcall(vim.fn.chanclose,ui.chan) n=n+1 end end return n end)()")'

# Colors for output
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

# Ensure session directory exists
mkdir -p "$SESSION_DIR"

# Function to get the init script to use
get_init_script() {
    local init_script="$CONFIG_DIR/init.lua"
    if [[ -f "$init_script" ]]; then
        echo "$init_script"
    else
        echo ""
    fi
}

# --------------------------------------------------------------------------
# Remote hosts
#
# nvim-screen does not run a control master of its own. Multiplexing is a
# property of the connection, not of this tool: whether repeated commands
# re-authenticate is decided by ControlMaster/ControlPath/ControlPersist in
# the user's own ~/.ssh/config, where it also benefits scp, rsync, git and
# every other ssh caller. Every invocation below is a plain 'ssh <host>', so
# it picks up whatever that config says - including a master someone else
# already started.
#
# The installer prints a recommended 'Host *' block; without one, remote
# commands simply authenticate each time.
# --------------------------------------------------------------------------

# Record a host we have talked to, so '-ls' and session lookup know where to
# look later. Written once per host; the file is per-user and lives beside
# the session sockets, so it goes away with them on reboot.
remember_ssh_host() {
    local ssh_host="$1"
    [[ -n "$ssh_host" ]] || return 0
    if [[ -f "$SSH_HOSTS_FILE" ]] && grep -qxF "$ssh_host" "$SSH_HOSTS_FILE" 2>/dev/null; then
        return 0
    fi
    echo "$ssh_host" >> "$SSH_HOSTS_FILE"
}

# Function to get all known SSH hosts, one per line
get_active_ssh_hosts() {
    [[ -f "$SSH_HOSTS_FILE" ]] || return 0
    sort -u "$SSH_HOSTS_FILE" 2>/dev/null || true
}

# True when the system's ssh config already has a live master for this host.
# Purely local and instant, so it is safe to ask before doing anything that
# must not block. Returns false when the user has no multiplexing configured
# at all, which is not an error - it just means queries pay for a connection.
ssh_master_running() {
    local ssh_host="$1"
    ${TIMEOUT_CMD:+$TIMEOUT_CMD 2} ssh -O check "$ssh_host" 2>&1 \
        | grep -q "Master running"
}

# Function to execute a command via SSH. Interactive-capable: this is the
# path a user-initiated action takes, so ssh may prompt for a passphrase.
ssh_exec() {
    local ssh_host="$1"
    shift
    ssh -o ConnectTimeout="$CONNECT_TIMEOUT" "$ssh_host" "$@"
}

# Function to run a short read-only query on a remote host. Time-limited and
# non-interactive, so a host that has gone away reports itself instead of
# hanging -ls or a session lookup, and a host that would need a password is
# skipped rather than prompting in the middle of a listing.
ssh_query() {
    local ssh_host="$1"
    shift
    ${TIMEOUT_CMD:+$TIMEOUT_CMD $QUERY_TIMEOUT} \
        ssh -o BatchMode=yes -o ConnectTimeout="$CONNECT_TIMEOUT" "$ssh_host" "$@"
}

# Function to find which remote host has a session
find_remote_session() {
    local session_name="$1"
    local hosts=() host
    while IFS= read -r host; do
        [[ -n "$host" ]] && hosts+=("$host")
    done < <(get_active_ssh_hosts)

    for host in ${hosts[@]+"${hosts[@]}"}; do
        # Check if session exists on this host
        if ssh_query "$host" "[ -S \"\${XDG_RUNTIME_DIR:-/tmp}/nvim-sessions-\$USER/nvim-session-$session_name.sock\" ]" 2>/dev/null; then
            echo "$host"
            return 0
        fi
    done

    return 1
}

# Function to open (or reuse) a connection to a host and remember it.
# With multiplexing configured this warms the master, so the commands that
# follow are free; without it, this is just an early reachability check that
# fails before we start pushing scripts around.
connect_ssh_host() {
    local ssh_host="$1"

    if ssh_master_running "$ssh_host"; then
        remember_ssh_host "$ssh_host"
        return 0
    fi

    if ! ssh_exec "$ssh_host" true; then
        echo -e "${RED}Failed to connect to $ssh_host${NC}"
        return 1
    fi

    remember_ssh_host "$ssh_host"
}

# Function to run nvim-screen on a remote host. Uses ssh_exec, not ssh_query:
# these are actions the user asked for, so ssh must be free to prompt for a
# passphrase on a host that has no multiplexed connection to ride on.
remote_screen() {
    local ssh_host="$1"
    shift
    ssh_exec "$ssh_host" "$REMOTE_PATH nvim-screen $*"
}

# Function to install nvim-screen (this script + config) on a remote host
bootstrap_remote() {
    local ssh_host="$1"
    local self="${BASH_SOURCE[0]}"

    if ! ssh_exec "$ssh_host" "$REMOTE_PATH command -v nvim" &>/dev/null; then
        echo -e "${RED}Error: nvim not found on $ssh_host.${NC}"
        echo "Run '$(basename "$0") -s $ssh_host -sync' to install Neovim there."
        return 1
    fi

    echo "Installing nvim-screen on $ssh_host..."
    ssh_exec "$ssh_host" 'mkdir -p "$HOME/.local/bin" "${XDG_CONFIG_HOME:-$HOME/.config}/nvim-screen"'
    ssh_exec "$ssh_host" 'cat > "$HOME/.local/bin/nvim-screen" && chmod +x "$HOME/.local/bin/nvim-screen"' < "$self"

    local init_script
    init_script=$(get_init_script)
    if [[ -n "$init_script" ]]; then
        ssh_exec "$ssh_host" 'cat > "${XDG_CONFIG_HOME:-$HOME/.config}/nvim-screen/init.lua"' < "$init_script"
    fi

    echo -e "${GREEN}nvim-screen installed on $ssh_host${NC}"
}

# Function to install Neovim itself on a remote host (official stable
# build into ~/.local, no root required)
install_remote_nvim() {
    local ssh_host="$1"
    local os arch asset
    os=$(ssh_exec "$ssh_host" 'uname -s' 2>/dev/null)
    arch=$(ssh_exec "$ssh_host" 'uname -m' 2>/dev/null)

    case "$os-$arch" in
        Linux-x86_64)           asset="nvim-linux-x86_64" ;;
        Linux-aarch64|Linux-arm64) asset="nvim-linux-arm64" ;;
        Darwin-x86_64)          asset="nvim-macos-x86_64" ;;
        Darwin-arm64)           asset="nvim-macos-arm64" ;;
        *)
            echo -e "${RED}Error: No prebuilt Neovim for $os/$arch. Install nvim on $ssh_host manually.${NC}"
            return 1
            ;;
    esac

    # NVIM_SCREEN_NVIM_URL overrides the download source (mirrors, air-gapped)
    local url="${NVIM_SCREEN_NVIM_URL:-https://github.com/neovim/neovim/releases/download/stable/${asset}.tar.gz}"

    echo "Installing Neovim (stable, $asset) on $ssh_host..."
    if ! ssh_exec "$ssh_host" "
        set -e
        url='$url'
        # BSD mktemp rejects templates with a suffix after the X's; tar
        # doesn't need the .tar.gz extension anyway
        tmp=\$(mktemp \"\${TMPDIR:-/tmp}/nvim-stable.XXXXXX\")
        if command -v curl >/dev/null 2>&1; then
            curl -fsSL \"\$url\" -o \"\$tmp\"
        elif command -v wget >/dev/null 2>&1; then
            wget -qO \"\$tmp\" \"\$url\"
        else
            echo 'Error: neither curl nor wget available on remote' >&2
            exit 1
        fi
        mkdir -p \"\$HOME/.local/opt\" \"\$HOME/.local/bin\"
        rm -rf \"\$HOME/.local/opt/${asset}\"
        tar -xzf \"\$tmp\" -C \"\$HOME/.local/opt\"
        rm -f \"\$tmp\"
        ln -sf \"\$HOME/.local/opt/${asset}/bin/nvim\" \"\$HOME/.local/bin/nvim\"
    "; then
        echo -e "${RED}Failed to install Neovim on $ssh_host${NC}"
        return 1
    fi

    local nvim_version
    nvim_version=$(ssh_exec "$ssh_host" "$REMOTE_PATH nvim --version" 2>/dev/null | head -1 || true)
    if [[ -z "$nvim_version" ]]; then
        echo -e "${RED}Neovim installed but not runnable on $ssh_host${NC}"
        return 1
    fi
    echo -e "${GREEN}Installed $nvim_version on $ssh_host${NC}"
}

# Function to sync nvim-screen and the local Neovim config to a remote host,
# installing Neovim itself if the remote doesn't have it
sync_remote() {
    local ssh_host="$1"

    if ! ssh_exec "$ssh_host" "$REMOTE_PATH command -v nvim" &>/dev/null; then
        install_remote_nvim "$ssh_host" || return 1
    fi

    bootstrap_remote "$ssh_host" || return 1

    local config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
    if [[ -d "$config_home/nvim" ]]; then
        echo "Syncing Neovim config to $ssh_host..."
        tar -C "$config_home" -czf - nvim | ssh_exec "$ssh_host" \
            'mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}" && tar -C "${XDG_CONFIG_HOME:-$HOME/.config}" -xzf -'
        echo -e "${GREEN}Neovim config synced. Plugins are installed by your plugin manager on first run.${NC}"
    else
        echo "No local Neovim config at $config_home/nvim, skipping config sync."
    fi
}

# Function to generate a session name
generate_session_name() {
    local base_name="${PWD##*/}"
    local counter=0
    local session_name="$base_name"

    while [[ -S "$SESSION_DIR/${SOCKET_PREFIX}-${session_name}.sock" ]]; do
        counter=$((counter + 1))
        session_name="${base_name}-${counter}"
    done

    echo "$session_name"
}

# Function to get socket path for a session
get_socket_path() {
    local session_name="$1"
    echo "$SESSION_DIR/${SOCKET_PREFIX}-${session_name}.sock"
}

# Function to check if a socket is healthy
check_socket_health() {
    local socket_path="$1"
    nvim --headless --server "$socket_path" --remote-expr '1+1' &>/dev/null
    return $?
}

# Function to list active sessions
list_sessions() {
    local ssh_host="$1"
    local has_sessions=false

    if [[ -n "$ssh_host" ]]; then
        # List remote sessions (when -s flag is used)
        echo "Active Neovim sessions on $ssh_host:"
        echo
        remote_screen "$ssh_host" "-ls" 2>&1
        return
    fi

    # List all sessions (local and remote)
    echo "Active Neovim sessions:"
    echo

    # List local sessions
    for socket in "$SESSION_DIR"/${SOCKET_PREFIX}-*.sock; do
        if [[ -S "$socket" ]]; then
            has_sessions=true
            local session_name="${socket##*/}"
            session_name="${session_name#${SOCKET_PREFIX}-}"
            session_name="${session_name%.sock}"

            # Check if session is healthy
            if check_socket_health "$socket"; then
                echo -e "  ${GREEN}●${NC} $session_name"
            else
                echo -e "  ${YELLOW}○${NC} $session_name (unresponsive)"
            fi
        fi
    done

    # List sessions on every host we have connected to. Each query is
    # non-interactive and time-limited, so a host that is unreachable (or
    # that would want a password) is skipped instead of hanging the listing.
    local hosts=() host
    while IFS= read -r host; do
        hosts+=("$host")
    done < <(get_active_ssh_hosts)

    for host in ${hosts[@]+"${hosts[@]}"}; do
        if [[ -n "$host" ]]; then
            # Get remote sessions
            local remote_sessions
            remote_sessions=$(ssh_query "$host" "
                for socket in \"\${XDG_RUNTIME_DIR:-/tmp}/nvim-sessions-\$USER\"/nvim-session-*.sock; do
                    if [[ -S \"\$socket\" ]]; then
                        name=\"\${socket##*/}\"
                        name=\"\${name#nvim-session-}\"
                        name=\"\${name%.sock}\"
                        echo \"\$name\"
                    fi
                done
            " 2>/dev/null)

            if [[ -n "$remote_sessions" ]]; then
                has_sessions=true
                while IFS= read -r session; do
                    if [[ -n "$session" ]]; then
                        echo -e "  ${GREEN}●${NC} ${host}:${session}"
                    fi
                done <<< "$remote_sessions"
            fi
        fi
    done

    if [[ "$has_sessions" == false ]]; then
        echo "  No active sessions"
    fi
    echo
}

# Function to attach a UI client to a session and report how it ended
run_client() {
    local session_name="$1"
    local socket_path
    socket_path=$(get_socket_path "$session_name")

    # Returns when this client detaches or the session ends
    TERMINAL_HANDED_OVER=1
    nvim --server "$socket_path" --remote-ui || true
    cleanup_terminal
    TERMINAL_HANDED_OVER=0

    if [[ -S "$socket_path" ]] && check_socket_health "$socket_path"; then
        echo "[detached from $session_name]"
    else
        echo "[session $session_name ended]"
    fi
}

# Function to start a new session
start_session() {
    local session_name="$1"
    local ssh_host="$2"
    local workdir="$3"
    shift 3
    # ${1+"$@"}: bash < 4.4 errors on "$@" under 'set -u' when there are
    # no positional parameters
    local nvim_args=(${1+"$@"})
    local socket_path
    socket_path=$(get_socket_path "$session_name")

    if [[ -n "$ssh_host" ]]; then
        # Start remote session via SSH
        local remote_cmd="$REMOTE_PATH nvim-screen -S '$session_name'"
        if [[ -n "$workdir" ]]; then
            printf -v remote_cmd '%s -c %q' "$remote_cmd" "$workdir"
        fi
        # Build nvim args string for remote execution
        if [[ ${#nvim_args[@]} -gt 0 ]]; then
            # Properly quote arguments for remote execution
            local nvim_args_str
            printf -v nvim_args_str ' -- %q' "${nvim_args[@]}"
            remote_cmd+="$nvim_args_str"
        fi

        echo "Starting remote session '$session_name' on $ssh_host..."

        # Run the remote nvim-screen over SSH with a pseudo-terminal. The
        # exit status is captured rather than left to 'set -e' so the
        # terminal is restored right here even when the connection itself
        # dies (ssh exits 255) with nvim still owning the screen.
        local status=0
        TERMINAL_HANDED_OVER=1
        ssh -t "$ssh_host" "$remote_cmd" || status=$?
        cleanup_terminal
        TERMINAL_HANDED_OVER=0
        if [[ $status -eq 255 ]]; then
            echo "[connection to $ssh_host lost - session keeps running, reattach with '$(basename "$0") -r $ssh_host:$session_name']"
        fi
        exit $status
    fi

    if [[ -S "$socket_path" ]]; then
        echo -e "${YELLOW}Session '$session_name' already exists.${NC}"
        echo "Use '$0 -r $session_name' to attach to it."
        exit 1
    fi

    # Local session: run the server headless, detached from this terminal,
    # so it survives client exits, terminal crashes, and SSH drops. The
    # terminal then attaches to it as a regular client.
    local init_script
    init_script=$(get_init_script)

    local server_cmd=(nvim --headless --listen "$socket_path")
    if [[ -n "$init_script" ]]; then
        server_cmd+=(-S "$init_script")
    fi
    server_cmd+=(${nvim_args[@]+"${nvim_args[@]}"})

    if command -v setsid &>/dev/null; then
        NVIM_SCREEN_SESSION="$session_name" setsid "${server_cmd[@]}" </dev/null &>/dev/null &
    else
        NVIM_SCREEN_SESSION="$session_name" nohup "${server_cmd[@]}" </dev/null &>/dev/null &
    fi

    # Wait for the server socket to appear
    local i
    for ((i = 0; i < 50; i++)); do
        [[ -S "$socket_path" ]] && break
        sleep 0.1
    done

    if [[ ! -S "$socket_path" ]] || ! check_socket_health "$socket_path"; then
        echo -e "${RED}Failed to start session '$session_name'${NC}"
        exit 1
    fi

    run_client "$session_name"
}

# Function to attach to existing session
attach_session() {
    local session_name="$1"
    local ssh_host=""
    local base_session_name="$session_name"

    # Check if session name contains host prefix (host:session format)
    if [[ "$session_name" =~ ^([^:]+):(.+)$ ]]; then
        ssh_host="${BASH_REMATCH[1]}"
        base_session_name="${BASH_REMATCH[2]}"

        echo "Attaching to remote session '$base_session_name' on $ssh_host..."

        if ! connect_ssh_host "$ssh_host"; then
            echo -e "${RED}Failed to establish SSH connection${NC}"
            exit 1
        fi

        # Verify session exists on remote before attempting to attach
        if ! ssh_exec "$ssh_host" "[ -S \"\${XDG_RUNTIME_DIR:-/tmp}/nvim-sessions-\$USER/nvim-session-$base_session_name.sock\" ]" 2>/dev/null; then
            echo -e "${RED}Error: Session '$base_session_name' not found on $ssh_host${NC}"
            exit 1
        fi

        # Attach over SSH with a pseudo-terminal. The exit status is
        # captured rather than left to 'set -e' so the terminal is restored
        # right here even when the connection itself dies (ssh exits 255)
        # with nvim still owning the screen.
        local status=0
        TERMINAL_HANDED_OVER=1
        ssh -t "$ssh_host" \
            "$REMOTE_PATH nvim-screen -r '$base_session_name'" || status=$?
        cleanup_terminal
        TERMINAL_HANDED_OVER=0
        if [[ $status -eq 255 ]]; then
            echo "[connection to $ssh_host lost - session keeps running, reattach with '$(basename "$0") -r $session_name']"
        fi
        exit $status
    fi

    # Not in host:session format, check locally first
    local socket_path
    socket_path=$(get_socket_path "$session_name")

    if [[ -S "$socket_path" ]]; then
        # Local session - attach to it
        run_client "$session_name"
        return
    fi

    # Not found anywhere
    echo -e "${RED}Error: Session '$session_name' not found.${NC}"
    echo
    list_sessions ""
    exit 1
}

# Function to detach all clients from a session
detach_session() {
    local session_name="$1"
    local ssh_host=""
    local base_session_name="$session_name"

    # Check if session name contains host prefix (host:session format)
    if [[ "$session_name" =~ ^([^:]+):(.+)$ ]]; then
        ssh_host="${BASH_REMATCH[1]}"
        base_session_name="${BASH_REMATCH[2]}"

        echo "Detaching from remote session '$base_session_name' on $ssh_host..."

        if ! connect_ssh_host "$ssh_host"; then
            echo -e "${RED}Failed to establish SSH connection${NC}"
            exit 1
        fi

        remote_screen "$ssh_host" "-d '$base_session_name'"
        return $?
    fi

    # Not in host:session format, check locally
    local socket_path
    socket_path=$(get_socket_path "$session_name")

    if [[ -S "$socket_path" ]]; then
        local detached
        detached=$(nvim --headless --server "$socket_path" \
            --remote-expr "$DETACH_UIS_LUA" 2>/dev/null || true)

        if [[ "$detached" =~ ^[0-9]+$ ]] && [[ "$detached" -gt 0 ]]; then
            echo -e "${GREEN}Detached $detached client(s) from session '$session_name'${NC}"
        else
            echo -e "${YELLOW}No clients attached to session '$session_name'${NC}"
        fi
        return
    fi

    # Check if this is a remote session
    ssh_host=$(find_remote_session "$session_name" || true)

    if [[ -n "$ssh_host" ]]; then
        # For remote session, execute detach on remote host
        echo "Detaching from remote session '$session_name' on $ssh_host..."

        remote_screen "$ssh_host" "-d '$session_name'"
        return $?
    fi

    echo -e "${RED}Error: Session '$session_name' not found.${NC}"
    exit 1
}

# Function to terminate a session
kill_session() {
    local session_name="$1"
    local ssh_host=""
    local base_session_name="$session_name"

    # Check if session name contains host prefix (host:session format)
    if [[ "$session_name" =~ ^([^:]+):(.+)$ ]]; then
        ssh_host="${BASH_REMATCH[1]}"
        base_session_name="${BASH_REMATCH[2]}"

        if ! connect_ssh_host "$ssh_host"; then
            echo -e "${RED}Failed to establish SSH connection${NC}"
            exit 1
        fi

        remote_screen "$ssh_host" "-k '$base_session_name'"
        return $?
    fi

    # Not in host:session format, check locally
    local socket_path
    socket_path=$(get_socket_path "$session_name")

    if [[ ! -S "$socket_path" ]]; then
        # Check if this is a remote session
        ssh_host=$(find_remote_session "$session_name" || true)
        if [[ -n "$ssh_host" ]]; then
            remote_screen "$ssh_host" "-k '$session_name'"
            return $?
        fi

        echo -e "${RED}Error: Session '$session_name' not found.${NC}"
        exit 1
    fi

    local pid
    pid=$(nvim --headless --server "$socket_path" --remote-expr 'getpid()' 2>/dev/null || true)

    if [[ "$pid" =~ ^[0-9]+$ ]]; then
        kill "$pid" 2>/dev/null || true
        echo -e "${GREEN}Session '$session_name' terminated.${NC}"
    else
        echo -e "${YELLOW}Session '$session_name' unresponsive, removing stale socket.${NC}"
    fi
    rm -f "$socket_path"
}

# Function to clean up stale sockets
cleanup_stale_sockets() {
    local cleaned=0

    # Clean up stale local session sockets
    for socket in "$SESSION_DIR"/${SOCKET_PREFIX}-*.sock; do
        if [[ -S "$socket" ]]; then
            # Check if socket is healthy
            if ! check_socket_health "$socket"; then
                echo "Removing stale socket: ${socket##*/}"
                rm -f "$socket"
                cleaned=$((cleaned + 1))
            fi
        fi
    done

    # Drop hosts that no longer answer. There are no control sockets of ours
    # to tear down - connections belong to the system's ssh config - so all
    # that can go stale here is the list of hosts we ask about.
    if [[ -f "$SSH_HOSTS_FILE" ]]; then
        local host live=() tmp
        while IFS= read -r host; do
            [[ -n "$host" ]] || continue
            if ssh_query "$host" true 2>/dev/null; then
                live+=("$host")
            else
                echo "Forgetting unreachable host: $host"
                cleaned=$((cleaned + 1))
            fi
        done < <(get_active_ssh_hosts)

        tmp=$(mktemp "${SSH_HOSTS_FILE}.XXXXXX") || tmp=""
        if [[ -n "$tmp" ]]; then
            if [[ ${#live[@]} -gt 0 ]]; then
                printf '%s\n' "${live[@]}" > "$tmp"
            else
                : > "$tmp"
            fi
            mv -f "$tmp" "$SSH_HOSTS_FILE"
        fi
    fi

    if [[ $cleaned -eq 0 ]]; then
        echo "No stale sessions found."
    else
        echo "Cleaned up $cleaned stale item(s)."
    fi
}

# Function to show version
show_version() {
    echo "nvim-screen version $VERSION"
}

# Function to show usage
show_usage() {
    cat << EOF
Neovim Session Manager - GNU screen-like interface for Neovim

Usage: $(basename "$0") [options] [command] [-- nvim_args...]

Options:
  -s <host>          Connect to remote host via SSH (auto-installs nvim-screen there)
  -S <name>          Start a new session with the specified name
  -c <dir>           Working directory for the new session (local or remote)
  -ls, -list         List all active sessions (local and remote)
  -r [name]          Attach to session (if name not specified, attach to last or prompt)
  -d <name>          Detach all clients from the specified session
  -k <name>          Kill (terminate) the specified session
  -sync              Sync nvim-screen and your Neovim config to the remote,
                     installing Neovim there if it's missing (with -s)
  -wipe              Clean up stale/dead sessions
  -fix               Restore a terminal left garbled by a dead session
                     (this also happens automatically when a session ends)
  -v, --version      Show version information
  -h, --help         Show this help message
  --                 Pass all following arguments to nvim

Examples:
  $(basename "$0") -S myproject                    # Start new session named 'myproject'
  $(basename "$0") -S myproject -- file.txt        # Start session and open file.txt
  $(basename "$0") -s user@host -S remote-proj     # Start session on remote host
  $(basename "$0") -s user@host -c ~/work/proj     # Remote session in ~/work/proj
  $(basename "$0") -s user@host -ls                # List sessions on remote host
  $(basename "$0") -s user@host -sync              # Push nvim + config + nvim-screen to host
  $(basename "$0") -r host:session                 # Attach to remote session
  $(basename "$0") -- -O file1.txt file2.txt       # Start session with vertical split
  $(basename "$0") -S test -- -c 'set number'      # Start session with nvim command

Inside Neovim:
  :q (and :qa, ZZ, ...)    Detach when the quit would end the session
  :Detach                  Detach all clients (session keeps running)
  :Quit                    Actually end the session

Session sockets are stored in: $SESSION_DIR
EOF
}

# Main script logic
main() {
    local action=""
    local session_name=""
    local ssh_host=""
    local workdir=""
    local do_sync=false
    local nvim_args=()

    # Parse command line arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -s)
                shift
                if [[ $# -gt 0 ]]; then
                    ssh_host="$1"
                    shift
                else
                    echo -e "${RED}Error: -s requires an SSH host${NC}"
                    exit 1
                fi
                ;;
            -S)
                action="start"
                shift
                if [[ $# -gt 0 ]]; then
                    session_name="$1"
                    shift
                else
                    echo -e "${RED}Error: -S requires a session name${NC}"
                    exit 1
                fi
                ;;
            -ls|-list)
                action="list"
                shift
                ;;
            -r|-x)
                action="attach"
                shift
                if [[ $# -gt 0 ]] && [[ ! "$1" =~ ^- ]]; then
                    session_name="$1"
                    shift
                fi
                ;;
            -d|-D)
                action="detach"
                shift
                if [[ $# -gt 0 ]]; then
                    session_name="$1"
                    shift
                else
                    echo -e "${RED}Error: -d requires a session name${NC}"
                    exit 1
                fi
                ;;
            -k|-kill)
                action="kill"
                shift
                if [[ $# -gt 0 ]]; then
                    session_name="$1"
                    shift
                else
                    echo -e "${RED}Error: -k requires a session name${NC}"
                    exit 1
                fi
                ;;
            -c)
                shift
                if [[ $# -gt 0 ]]; then
                    workdir="$1"
                    shift
                else
                    echo -e "${RED}Error: -c requires a directory${NC}"
                    exit 1
                fi
                ;;
            -sync)
                do_sync=true
                shift
                ;;
            -wipe)
                action="wipe"
                shift
                ;;
            -fix)
                action="fix"
                shift
                ;;
            -v|--version)
                show_version
                exit 0
                ;;
            -h|--help)
                show_usage
                exit 0
                ;;
            --)
                # Everything after -- is passed to nvim
                shift
                nvim_args=(${1+"$@"})
                break
                ;;
            *)
                echo -e "${RED}Unknown option: $1${NC}"
                echo
                show_usage
                exit 1
                ;;
        esac
    done

    # -sync only makes sense against a remote host
    if [[ -z "$ssh_host" ]] && [[ "$do_sync" == true ]]; then
        echo -e "${RED}Error: -sync requires -s <host>${NC}"
        exit 1
    fi

    # Default action: start a session, unless the invocation was only about
    # syncing the remote
    if [[ -z "$action" ]]; then
        if [[ "$do_sync" == true ]] && [[ ${#nvim_args[@]} -eq 0 ]]; then
            action="none"
        else
            action="start"
        fi
    fi

    # A local working directory applies right away; a remote one is passed
    # along to the remote nvim-screen invocation in start_session
    if [[ -n "$workdir" ]] && [[ -z "$ssh_host" ]]; then
        if ! cd "$workdir" 2>/dev/null; then
            echo -e "${RED}Error: Cannot change to directory '$workdir'${NC}"
            exit 1
        fi
    fi

    # Handle SSH connection if specified
    if [[ -n "$ssh_host" ]]; then
        echo "Connecting to $ssh_host..."
        if ! connect_ssh_host "$ssh_host"; then
            exit 1
        fi

        if [[ "$do_sync" == true ]]; then
            sync_remote "$ssh_host" || exit 1
        else
            # Install nvim-screen on the remote if it's missing, and keep
            # it in step with the local version
            local remote_version
            remote_version=$(remote_screen "$ssh_host" "-v" 2>/dev/null | awk '{print $NF}' || true)
            if [[ "$remote_version" != "$VERSION" ]]; then
                if [[ -z "$remote_version" ]]; then
                    echo -e "${YELLOW}nvim-screen not found on $ssh_host${NC}"
                else
                    echo -e "${YELLOW}Updating nvim-screen on $ssh_host ($remote_version -> $VERSION)${NC}"
                fi
                bootstrap_remote "$ssh_host" || exit 1
            fi
        fi
    fi

    # Execute action
    case "$action" in
        none)
            ;;
        list)
            list_sessions "$ssh_host"
            ;;
        start)
            if [[ -z "$session_name" ]]; then
                if [[ -n "$ssh_host" ]] && [[ -n "$workdir" ]]; then
                    session_name=$(basename "$workdir")
                else
                    session_name=$(generate_session_name)
                fi
            fi
            start_session "$session_name" "$ssh_host" "$workdir" ${nvim_args[@]+"${nvim_args[@]}"}
            ;;
        attach)
            if [[ -z "$session_name" ]]; then
                # Find available local sessions
                local available_sessions=()

                for socket in "$SESSION_DIR"/${SOCKET_PREFIX}-*.sock; do
                    if [[ -S "$socket" ]]; then
                        local name="${socket##*/}"
                        name="${name#${SOCKET_PREFIX}-}"
                        name="${name%.sock}"
                        available_sessions+=("$name")
                    fi
                done

                if [[ ${#available_sessions[@]} -eq 0 ]]; then
                    echo -e "${RED}No active local sessions found.${NC}"
                    echo "Use 'nvim-screen -ls' to see all sessions including remote ones."
                    exit 1
                elif [[ ${#available_sessions[@]} -eq 1 ]]; then
                    session_name="${available_sessions[0]}"
                else
                    echo "Multiple sessions available:"
                    for i in "${!available_sessions[@]}"; do
                        echo "  $((i+1)). ${available_sessions[$i]}"
                    done
                    echo
                    read -r -p "Select session number (or name): " selection
                    if [[ "$selection" =~ ^[0-9]+$ ]] && [[ $selection -le ${#available_sessions[@]} ]]; then
                        session_name="${available_sessions[$((selection-1))]}"
                    else
                        session_name="$selection"
                    fi
                fi
            fi
            attach_session "$session_name"
            ;;
        detach)
            detach_session "$session_name"
            ;;
        kill)
            kill_session "$session_name"
            ;;
        wipe)
            cleanup_stale_sockets
            echo "Stale sessions cleaned up."
            ;;
        fix)
            # Force the cleanup: the guard flag exists to skip cleanup on
            # non-interactive invocations, but here fixing the terminal IS
            # the requested action
            TERMINAL_HANDED_OVER=1
            cleanup_terminal
            TERMINAL_HANDED_OVER=0
            echo "Terminal restored."
            ;;
    esac
}

main ${1+"$@"}
